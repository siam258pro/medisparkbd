# Copy to whiteboard/.env (same folder as package.json). NEVER commit the real file.
# The browser bundle must never contain this key — only server/server.ts reads it.

# Base URL of an OpenAI-compatible vision chat-completions endpoint
LLM_API_URL=https://api.openai.com/v1/chat/completions
# Secret key for the endpoint above (server-side only!)
LLM_API_KEY=
# Vision-capable model name
LLM_MODEL=gpt-4o-mini

# Backend port (Vite proxies /api here in dev)
PORT=3001
# Max requests per IP per minute
RATE_PER_MIN=20
# Upstream vision-model timeout (ms)
LLM_TIMEOUT_MS=25000
